# ===== 大模型（必填）=====
# DeepSeek 官方；任何 OpenAI 兼容接口都可以，改 LLM_BASE_URL 即可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 判题模型（flash 实测准确率与 chat 相同，但快约 2 秒）
LLM_MODEL=deepseek-flash
# 答案模型（可留空，跟随判题模型）
LLM_ANSWER_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=90
# 记录每次调用的出入参到 SQLite，排查用；设 0 关闭
LLM_LOG=1
# 深度思考开关（DeepSeek 原生 thinking 参数）：1=面试回答默认先思考，0=直接作答
LLM_THINKING=1

# ===== 语音识别（四选一）=====
# auto：有火山 Key 用火山，否则用本地离线
ASR_PROVIDER=auto

# -- 本地离线（sherpa-onnx paraformer，无需 Key）--
# 模型目录；留空则自动在 models/ 下找
ASR_MODEL_DIR=

# -- 火山豆包流式语音识别 2.0 --
VOLC_SPEECH_KEY=
VOLC_APP_ID=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# -- DeepSeek 官方 ASR（/v1/tools/asr，整段上传，≤120 秒/句）--
# 留空则复用 LLM_API_KEY / LLM_BASE_URL
DEEPSEEK_ASR_KEY=
DEEPSEEK_ASR_BASE_URL=

# -- 云端 OpenAI 兼容 /audio/transcriptions --
CLOUD_ASR_BASE_URL=https://api.siliconflow.cn/v1
CLOUD_ASR_KEY=
CLOUD_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
CLOUD_ASR_LANGUAGE=zh

# ===== 采集 =====
# 能量门限：低于它算静音（安静房间底噪 0.001~0.003）
VAD_THRESHOLD=0.008
# 连续静音多久算一句话说完（毫秒），太小会把句子切碎
VAD_SILENCE_MS=900
BUFFER_SECONDS=2.0

# ===== 判题 =====
# 置信度低于它就不出卡片
JUDGE_CONFIDENCE=0.6
# 新的一段转写进来后等多久再判（毫秒），避免一句话被切碎时反复判
JUDGE_DEBOUNCE_MS=900
# 单次判题最长等多久（秒），超时用规则兜底，避免一次网络抖动卡住整场
JUDGE_TIMEOUT=20
# 新问题默认展示的答案版本：brief | standard | deep
ANSWER_LEVEL=standard

# ===== 日志 =====
# 排查问题看 data/logs/app.log（滚动，最多 5 个 5MB 文件）
# 控制台级别：DEBUG / INFO / WARNING / ERROR；文件始终记录 DEBUG
LOG_LEVEL=INFO
# 0 = 只输出到控制台，不写文件
LOG_FILE=1
# 日志目录，默认 <项目>/data/logs
LOG_DIR=

# ===== 服务与存储 =====
HOST=127.0.0.1
PORT=8765
MODELS_DIR=./models
DATA_DIR=./data

# 仿真 TTS 引擎：auto（先本机 SAPI，失败回退在线）/ sapi（只本机）/ edge（只在线）
TTS_ENGINE=auto
